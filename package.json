{
  "name": "morechat",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:clear": "expo start --web --clear",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "lint": "oxlint .",
    "lint:staged": "lint-staged",
    "knip": "knip",
    "arch": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "commitlint": "commitlint --edit",
    "check": "pnpm format:check && pnpm lint && pnpm arch && pnpm typecheck && pnpm knip && pnpm test",
    "export:android": "expo export --platform android --output-dir build",
    "export:web": "expo export --platform web --output-dir dist",
    "doctor": "npx expo-doctor",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{js,cjs,mjs,json,md,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-font": "~58.0.12",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.1",
    "react-native-web": "^0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@expo/ngrok": "^4.1.3",
    "@react-native/codegen": "0.88.1",
    "@react-native/gradle-plugin": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.12.0"
  }
}
